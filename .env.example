# Copy this file to .env, then replace the placeholders with your local PostgreSQL settings.
# URL-encode special characters in the username/password if needed.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/it_assetmaster
PGSSL=false
PGPOOL_MAX=10
PORT=5000
# Keep the API on this machine; Vite proxies LAN browser requests to this loopback address.
API_HOST=127.0.0.1
# Set true to permit browser requests from private IPv4 LAN addresses on the Vite port.
ALLOW_LAN_ORIGINS=true
VITE_PORT=5173
# Additional browser origins to allow besides private LAN IPv4 origins when enabled above.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Used only to create the first internal admin when auth_accounts is empty.
# Use a unique password of at least 12 characters; remove these values after first startup.
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
